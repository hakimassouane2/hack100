<form>
  <div class="form-group">
    <label>{{localize "hack100.rollDialog.target"}}</label>
    <input type="number" name="target" value="{{target}}" readonly />
  </div>

  {{#if agilityPenalty}}
  <div class="form-group">
    <p class="hint" style="color: #c53030; font-style: italic;">{{localize "hack100.items.agilityPenalty"}} {{localize "hack100.rollDialog.fromArmor"}}: -{{agilityPenalty}}% ({{localize "hack100.rollDialog.alreadyApplied"}})</p>
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "hack100.rollDialog.modifier"}}</label>
    <select name="modifier">
      <option value="-40">{{localize "hack100.rollDialog.veryHard"}}</option>
      <option value="-20">{{localize "hack100.rollDialog.hard"}}</option>
      <option value="0" selected>{{localize
          "hack100.rollDialog.normal"
        }}</option>
      <option value="20">{{localize "hack100.rollDialog.easy"}}</option>
    </select>
  </div>

  <div class="form-group">
    <label>{{localize "hack100.rollDialog.customModifier"}}</label>
    <input type="number" name="customModifier" value="0" />
  </div>
</form>