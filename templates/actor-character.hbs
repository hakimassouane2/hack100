<form class="{{cssClass}} {{actor.type}}" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize "hack100.character.namePlaceholder"}}"/>
      </h1>
      <div class="background-motivation">
        <label for="system.greatBecause">{{localize "hack100.character.greatBecause"}}</label>
        <textarea name="system.greatBecause" rows="2">{{system.greatBecause}}</textarea>
      </div>
      <div class="background-motivation">
        <label for="system.societyProblem">{{localize "hack100.character.societyProblem"}}</label>
        <textarea name="system.societyProblem" rows="2">{{system.societyProblem}}</textarea>
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="main">{{localize "hack100.tabs.main"}}</a>
    <a class="item" data-tab="equipment">{{localize "hack100.tabs.equipment"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Main Tab --}}
    <div class="tab main" data-group="primary" data-tab="main">

      {{!-- Row 1: Health and SP (2 columns) --}}
      <div class="resources-row">
        {{!-- Health Section --}}
        <div class="health-section">
          <h3>{{localize "hack100.character.health"}}</h3>
          <div class="health-tracker">
            <div class="health-current">
              <label>{{localize "hack100.global.current"}}</label>
              <input type="number" name="system.health.value" value="{{system.health.value}}" min="0" max="{{system.health.max}}" data-health-percent="{{system.healthPercent}}"/>
            </div>
            <div class="health-max">
              <label>{{localize "hack100.global.maximum"}}</label>
              <span>{{system.health.max}}</span>
            </div>
            <div class="health-temp">
              <label>{{localize "hack100.character.tempHP"}}</label>
              <input type="number" name="system.health.temp" value="{{system.health.temp}}" min="0" placeholder="0"/>
            </div>
          </div>
        </div>

        {{!-- Specialism Points Section --}}
        <div class="sp-section">
          <h3>{{localize "hack100.sp.title"}}</h3>
          <div class="sp-tracker">
            <div class="sp-current">
              <label>{{localize "hack100.global.current"}}</label>
              <input type="number" name="system.sp.value" value="{{system.sp.value}}" min="0" max="{{system.sp.max}}" data-sp-percent="{{system.spPercent}}" class="{{#if (lte system.sp.value 0)}}sp-empty{{else if (lte system.sp.value 2)}}sp-low{{/if}}"/>
            </div>
            <div class="sp-max">
              <label>{{localize "hack100.global.maximum"}}</label>
              <span>{{system.sp.max}}</span>
            </div>
          </div>
        </div>
      </div>

      {{!-- Row 2: Movement, Luck, Rest (3 columns) --}}
      <div class="secondary-row">
        {{!-- Movement Section --}}
        <div class="movement-section">
          <h3>{{localize "hack100.character.movement"}}</h3>
          <div class="movement-value">
            <span>{{system.movement}}</span> {{localize "hack100.character.squares"}}
          </div>
        </div>

        {{!-- Luck Section --}}
        <div class="luck-section">
          <h3>{{localize "hack100.luck.title"}}</h3>
          <div class="luck-tracker">
            <div class="luck-pips" title="{{localize "hack100.luck.clickHint"}}">
              {{#each (array 1 2 3) as |pip|}}
              <span class="luck-pip {{#if (lte pip ../system.luck.value)}}filled{{/if}}" data-pip="{{pip}}">
                <i class="{{#if (lte pip ../system.luck.value)}}fas{{else}}far{{/if}} fa-clover"></i>
              </span>
              {{/each}}
            </div>
          </div>
        </div>

        {{!-- Rest Section --}}
        <div class="rest-section">
          <h3>{{localize "hack100.rest.title"}}</h3>
          <div class="rest-buttons">
            <button type="button" class="rest-button short-rest" {{#if system.shortRestUsed}}disabled{{/if}} title="{{#if system.shortRestUsed}}{{localize "hack100.rest.shortRestUsed"}}{{else}}{{localize "hack100.rest.shortRestHint"}}{{/if}}">
              <i class="fas fa-campground"></i> {{localize "hack100.rest.shortRest"}}
            </button>
            <button type="button" class="rest-button long-rest" title="{{localize "hack100.rest.longRestHint"}}">
              <i class="fas fa-bed"></i> {{localize "hack100.rest.longRest"}}
            </button>
          </div>
        </div>
      </div>

      {{!-- Abilities Section --}}
      <div class="abilities-section">
        <h3>{{localize "hack100.character.abilities"}}</h3>
        <div class="abilities-grid">
          {{#each system.abilities as |ability key|}}
          <div class="ability-block">
            <div class="ability-header">
              <h4>{{localize (concat "hack100.abilities." key)}}</h4>
              <div class="ability-bonus-wrapper">
                {{#if ability.experienceCheck}}
                <a class="xp-reset" data-ability="{{key}}" title="{{localize "hack100.tooltips.xpReset"}}">
                  <i class="fas fa-eraser"></i>
                </a>
                {{/if}}
                <span class="ability-bonus">{{localize "hack100.global.bonus"}}: {{ability.bonus}}</span>
              </div>
            </div>
            <div class="ability-value">
              <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" min="0" max="100"/>
              <span>%</span>
            </div>
            <div class="ability-controls">
              <button type="button" class="rollable" data-ability="{{key}}">{{localize "hack100.global.roll"}}</button>
              <button type="button" class="experience-roll" data-ability="{{key}}" {{#unless ability.experienceCheck}}disabled{{/unless}} title="{{#if ability.experienceCheck}}{{localize "hack100.tooltips.xpAvailable"}}{{else}}{{localize "hack100.tooltips.xpNotAvailable"}}{{/if}}">{{localize "hack100.global.xp"}}</button>
            </div>
          </div>
          {{/each}}
        </div>
      </div>

      {{!-- Specialisms Section --}}
      <div class="specialisms-section">
        <h3>{{localize "hack100.character.specialisms"}}</h3>
        <div class="specialisms-list">
          {{#each system.specialisms as |specialism key|}}
          <div class="specialism-item">
            <input type="text" name="system.specialisms.{{key}}.name" value="{{#if specialism.name}}{{specialism.name}}{{/if}}" placeholder="{{localize "hack100.character.specialismPlaceholder"}}"/>
            <input type="number" name="system.specialisms.{{key}}.value" value="{{specialism.value}}" min="0" max="100" step="1"/>
            <span>%</span>
            {{#if specialism.name}}
            <button type="button" class="rollable" data-ability="{{key}}">{{localize "hack100.global.roll"}}</button>
            <button type="button" class="experience-roll" data-ability="{{key}}" {{#unless specialism.experienceCheck}}disabled{{/unless}} title="{{#if specialism.experienceCheck}}{{localize "hack100.tooltips.xpAvailable"}}{{else}}{{localize "hack100.tooltips.xpNotAvailable"}}{{/if}}">{{localize "hack100.buttons.experience"}}</button>
            {{/if}}
            <button type="button" class="specialism-delete" data-specialism="{{key}}" title="{{localize "hack100.buttons.delete"}}">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          {{/each}}
        </div>
        <button type="button" class="specialism-add" title="{{localize "hack100.buttons.add"}} {{localize "hack100.character.specialisms"}}">
          <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
        </button>
      </div>

    </div>

    {{!-- Equipment Tab --}}
    <div class="tab equipment" data-group="primary" data-tab="equipment">

      {{!-- Currency Section --}}
      <div class="currency-row">
        <div class="currency-item gold">
          <label>{{localize "hack100.currency.gold"}}</label>
          <div class="currency-input-group">
            <i class="fas fa-coins currency-icon"></i>
            <input type="number" name="system.currency.gold" value="{{system.currency.gold}}" min="0"/>
          </div>
        </div>
        <div class="currency-item silver">
          <label>{{localize "hack100.currency.silver"}}</label>
          <div class="currency-input-group">
            <i class="fas fa-coins currency-icon"></i>
            <input type="number" name="system.currency.silver" value="{{system.currency.silver}}" min="0"/>
          </div>
        </div>
        <div class="currency-item copper">
          <label>{{localize "hack100.currency.copper"}}</label>
          <div class="currency-input-group">
            <i class="fas fa-coins currency-icon"></i>
            <input type="number" name="system.currency.copper" value="{{system.currency.copper}}" min="0"/>
          </div>
        </div>
        <div class="currency-actions">
          <button type="button" class="currency-convert" title="{{localize "hack100.currency.convert"}}">
            <i class="fas fa-exchange-alt"></i>
          </button>
          <button type="button" class="currency-transfer" title="{{localize "hack100.currency.transfer"}}">
            <i class="fas fa-paper-plane"></i>
          </button>
        </div>
      </div>

      {{!-- Weapons --}}
      <div class="items-section weapons-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="weapons"></i>
            {{localize "hack100.items.weapon"}}
          </h3>
          <a class="item-control item-create" data-type="weapon">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list weapons-list collapsible-content">
          {{#if weapons.length}}
            {{#each weapons as |item id|}}
            <li class="item weapon-item" data-item-id="{{item._id}}">
              <div class="item-header">
                <div class="item-image">
                  <a class="rollable" data-roll-type="item"><img src="{{item.img}}" title="{{item.name}}" width="36" height="36"/></a>
                </div>
                <div class="item-name-equipped">
                  <h4>{{item.name}}</h4>
                  <div class="item-equipped-status">
                    <label class="equipped-checkbox">
                      <input type="checkbox" name="items.{{item._id}}.system.equipped" {{#if item.system.equipped}}checked{{/if}}/>
                      <span>{{localize "hack100.items.equippedInUse"}}</span>
                    </label>
                  </div>
                </div>
              </div>
              <div class="item-stats">
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.damageModifier"}}:</span>
                  <span class="stat-value damage-value">{{item.system.damage}}</span>
                </div>
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.weaponType"}}:</span>
                  <span class="stat-value"> {{localize (concat "hack100.items." item.system.weaponType)}}</span>
                </div>
                {{#if item.system.range}}
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.range"}}:</span>
                  <span class="stat-value">{{item.system.range}}</span>
                </div>
                {{/if}}
              </div>
              <div class="item-controls">
                <a class="item-control item-edit" title="{{localize "hack100.buttons.edit"}}"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="{{localize "hack100.buttons.delete"}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.items.noWeapons"}}</p>
          {{/if}}
        </ol>
      </div>

      {{!-- Armor --}}
      <div class="items-section armor-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="armor"></i>
            {{localize "hack100.items.armor"}}
          </h3>
          <a class="item-control item-create" data-type="armor">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list armor-list collapsible-content">
          {{#if armor.length}}
            {{#each armor as |item id|}}
            <li class="item armor-item" data-item-id="{{item._id}}">
              <div class="item-header">
                <div class="item-image">
                  <img src="{{item.img}}" title="{{item.name}}" width="36" height="36"/>
                </div>
                <div class="item-name-equipped">
                  <h4>{{item.name}}</h4>
                  <div class="item-equipped-status">
                    <label class="equipped-checkbox">
                      <input type="checkbox" name="items.{{item._id}}.system.equipped" {{#if item.system.equipped}}checked{{/if}}/>
                      <span>{{localize "hack100.items.equippedInUse"}}</span>
                    </label>
                  </div>
                </div>
              </div>
              <div class="item-stats">
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.protectionValue"}}:</span>
                  <span class="stat-value protection-value">{{item.system.protection}}</span>
                </div>
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.movementPenalty"}}:</span>
                  <span class="stat-value penalty-value">-{{item.system.movementPenalty}}</span>
                </div>
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.agilityPenalty"}}:</span>
                  <span class="stat-value penalty-value">{{#if item.system.agilityPenalty}}-{{item.system.agilityPenalty}}%{{else}}0%{{/if}}</span>
                </div>
              </div>
              <div class="item-controls">
                <a class="item-control item-edit" title="{{localize "hack100.buttons.edit"}}"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="{{localize "hack100.buttons.delete"}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.items.noArmor"}}</p>
          {{/if}}
        </ol>
      </div>

      {{!-- Other Equipment --}}
      <div class="items-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="equipment"></i>
            {{localize "hack100.items.equipment"}}
          </h3>
          <a class="item-control item-create" data-type="item">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list collapsible-content">
          {{#if gear.length}}
            {{#each gear as |item id|}}
            <li class="item flexrow" data-item-id="{{item._id}}">
              <div class="item-name">
                <div class="item-image">
                  <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                </div>
                <h4>{{item.name}}</h4>
              </div>
              <div class="item-controls">
                <a class="item-control item-edit" title="{{localize "hack100.buttons.edit"}} {{localize "hack100.items.item"}}"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="{{localize "hack100.buttons.delete"}} {{localize "hack100.items.item"}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.items.noEquipment"}}</p>
          {{/if}}
        </ol>
      </div>

    </div>

  </section>
</form>