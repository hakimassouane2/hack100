<form class="{{cssClass}} {{actor.type}}" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Enter name"/>
      </h1>
      <div class="background-motivation">
        <label for="system.background">{{localize "hack100.character.background"}}</label>
        <textarea name="system.background" placeholder="{{localize "hack100.character.backgroundPlaceholder"}}">{{system.background}}</textarea>
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="main">{{localize "hack100.tabs.main"}}</a>
    <a class="item" data-tab="equipment">{{localize "hack100.tabs.equipment"}}</a>
    <a class="item" data-tab="journal">{{localize "hack100.tabs.journal"}}</a>
    <a class="item" data-tab="settings">{{localize "hack100.tabs.settings"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Main Tab --}}
    <div class="tab main" data-group="primary" data-tab="main">

      {{!-- Health and Movement Row --}}
      <div class="health-movement-row">
        {{!-- Health Section --}}
        <div class="health-section">
          <h3>{{localize "hack100.character.health"}}</h3>
          <div class="health-tracker">
            <div class="health-current">
              <label>{{localize "hack100.global.current"}}</label>
              <input type="number" name="system.health.value" value="{{system.health.value}}" min="0" data-health-percent="{{system.healthPercent}}"/>
            </div>
            <div class="health-max">
              <label>{{localize "hack100.global.maximum"}}</label>
              <span>{{system.health.max}}</span>
            </div>
            <div class="health-temp">
              <label>{{localize "hack100.character.tempHP"}}</label>
              <input type="number" name="system.health.temp" value="{{system.health.temp}}" min="0" placeholder="0"/>
            </div>
          </div>
        </div>

        {{!-- Luck Section --}}
        <div class="luck-section">
          <h3>{{localize "hack100.luck.title"}}</h3>
          <div class="luck-tracker">
            <div class="luck-pips" title="{{localize "hack100.luck.clickHint"}}">
              {{#each (array 1 2 3) as |pip|}}
              <span class="luck-pip {{#if (lte pip ../system.luck.value)}}filled{{/if}}" data-pip="{{pip}}">
                <i class="{{#if (lte pip ../system.luck.value)}}fas{{else}}far{{/if}} fa-clover"></i>
              </span>
              {{/each}}
            </div>
          </div>
        </div>

        {{!-- Movement Section --}}
        <div class="movement-section">
          <h3>{{localize "hack100.character.movement"}}</h3>
          <div class="movement-value">
            <span>{{system.movement}}</span> {{localize "hack100.character.squares"}}
          </div>
        </div>
      </div>

      {{!-- Abilities Section --}}
      <div class="abilities-section">
        <h3>{{localize "hack100.character.abilities"}}</h3>
        <div class="abilities-grid">
          {{#each system.abilities as |ability key|}}
          <div class="ability-block">
            <div class="ability-header">
              <h4>{{localize (concat "hack100.abilities." key)}}</h4>
              <span class="ability-bonus">{{localize "hack100.global.bonus"}}: {{ability.bonus}}</span>
            </div>
            <div class="ability-value">
              <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" min="0" max="100"/>
              <span>%</span>
            </div>
            <div class="ability-controls">
              <button type="button" class="rollable" data-ability="{{key}}">{{localize "hack100.global.roll"}}</button>
              <button type="button" class="experience-roll" data-ability="{{key}}" {{#unless ability.experienceCheck}}disabled{{/unless}} title="{{#if ability.experienceCheck}}{{localize "hack100.tooltips.xpAvailable"}}{{else}}{{localize "hack100.tooltips.xpNotAvailable"}}{{/if}}">{{localize "hack100.global.xp"}}</button>
            </div>
          </div>
          {{/each}}
        </div>
      </div>

      {{!-- Specialisms Section --}}
      <div class="specialisms-section">
        <h3>{{localize "hack100.character.specialisms"}}</h3>
        <div class="specialisms-list">
          {{#each system.specialisms as |specialism key|}}
          <div class="specialism-item">
            <input type="text" name="system.specialisms.{{key}}.name" value="{{#if specialism.name}}{{specialism.name}}{{/if}}" placeholder="Specialism name"/>
            <input type="number" name="system.specialisms.{{key}}.value" value="{{specialism.value}}" min="0" max="100" step="1"/>
            <span>%</span>
            {{#if specialism.name}}
            <button type="button" class="rollable" data-ability="{{key}}">{{localize "hack100.global.roll"}}</button>
            <button type="button" class="experience-roll" data-ability="{{key}}" {{#unless specialism.experienceCheck}}disabled{{/unless}} title="{{#if specialism.experienceCheck}}{{localize "hack100.tooltips.xpAvailable"}}{{else}}{{localize "hack100.tooltips.xpNotAvailable"}}{{/if}}">{{localize "hack100.buttons.experience"}}</button>
            {{/if}}
            <button type="button" class="specialism-delete" data-specialism="{{key}}" title="{{localize "hack100.buttons.delete"}}">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          {{/each}}
        </div>
        <button type="button" class="specialism-add" title="{{localize "hack100.buttons.add"}} {{localize "hack100.character.specialisms"}}">
          <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
        </button>
      </div>

    </div>

    {{!-- Equipment Tab --}}
    <div class="tab equipment" data-group="primary" data-tab="equipment">

      {{!-- Currency Section --}}
      <div class="currency-row">
        <div class="currency-item gold">
          <label>{{localize "hack100.currency.gold"}}</label>
          <div class="currency-input-group">
            <i class="fas fa-coins currency-icon"></i>
            <input type="number" name="system.currency.gold" value="{{system.currency.gold}}" min="0"/>
          </div>
        </div>
        <div class="currency-item silver">
          <label>{{localize "hack100.currency.silver"}}</label>
          <div class="currency-input-group">
            <i class="fas fa-coins currency-icon"></i>
            <input type="number" name="system.currency.silver" value="{{system.currency.silver}}" min="0"/>
          </div>
        </div>
        <div class="currency-item copper">
          <label>{{localize "hack100.currency.copper"}}</label>
          <div class="currency-input-group">
            <i class="fas fa-coins currency-icon"></i>
            <input type="number" name="system.currency.copper" value="{{system.currency.copper}}" min="0"/>
          </div>
        </div>
        <div class="currency-actions">
          <button type="button" class="currency-convert" title="{{localize "hack100.currency.convert"}}">
            <i class="fas fa-exchange-alt"></i>
          </button>
          <button type="button" class="currency-transfer" title="{{localize "hack100.currency.transfer"}}">
            <i class="fas fa-paper-plane"></i>
          </button>
        </div>
      </div>

      {{!-- Weapons --}}
      <div class="items-section weapons-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="weapons"></i>
            {{localize "hack100.items.weapon"}}
          </h3>
          <a class="item-control item-create" data-type="weapon">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list weapons-list collapsible-content">
          {{#if weapons.length}}
            {{#each weapons as |item id|}}
            <li class="item weapon-item" data-item-id="{{item._id}}">
              <div class="item-header">
                <div class="item-image">
                  <a class="rollable" data-roll-type="item"><img src="{{item.img}}" title="{{item.name}}" width="36" height="36"/></a>
                </div>
                <div class="item-name-equipped">
                  <h4>{{item.name}}</h4>
                  <div class="item-equipped-status">
                    <label class="equipped-checkbox">
                      <input type="checkbox" name="items.{{item._id}}.system.equipped" {{#if item.system.equipped}}checked{{/if}}/>
                      <span>{{localize "hack100.items.equippedInUse"}}</span>
                    </label>
                  </div>
                </div>
              </div>
              <div class="item-stats">
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.damageModifier"}}:</span>
                  <span class="stat-value damage-value">{{item.system.damage}}</span>
                </div>
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.weaponType"}}:</span>
                  <span class="stat-value"> {{localize (concat "hack100.items." item.system.weaponType)}}</span>
                </div>
                {{#if item.system.range}}
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.range"}}:</span>
                  <span class="stat-value">{{item.system.range}}</span>
                </div>
                {{/if}}
              </div>
              <div class="item-controls">
                <a class="item-control item-edit" title="{{localize "hack100.buttons.edit"}}"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="{{localize "hack100.buttons.delete"}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.items.noWeapons"}}</p>
          {{/if}}
        </ol>
      </div>

      {{!-- Armor --}}
      <div class="items-section armor-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="armor"></i>
            {{localize "hack100.items.armor"}}
          </h3>
          <a class="item-control item-create" data-type="armor">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list armor-list collapsible-content">
          {{#if armor.length}}
            {{#each armor as |item id|}}
            <li class="item armor-item" data-item-id="{{item._id}}">
              <div class="item-header">
                <div class="item-image">
                  <img src="{{item.img}}" title="{{item.name}}" width="36" height="36"/>
                </div>
                <div class="item-name-equipped">
                  <h4>{{item.name}}</h4>
                  <div class="item-equipped-status">
                    <label class="equipped-checkbox">
                      <input type="checkbox" name="items.{{item._id}}.system.equipped" {{#if item.system.equipped}}checked{{/if}}/>
                      <span>{{localize "hack100.items.equippedInUse"}}</span>
                    </label>
                  </div>
                </div>
              </div>
              <div class="item-stats">
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.protectionValue"}}:</span>
                  <span class="stat-value protection-value">{{item.system.protection}}</span>
                </div>
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.movementPenalty"}}:</span>
                  <span class="stat-value penalty-value">-{{item.system.movementPenalty}}</span>
                </div>
                <div class="stat-group">
                  <span class="stat-label">{{localize "hack100.items.agilityPenalty"}}:</span>
                  <span class="stat-value penalty-value">{{#if item.system.agilityPenalty}}-{{item.system.agilityPenalty}}%{{else}}0%{{/if}}</span>
                </div>
              </div>
              <div class="item-controls">
                <a class="item-control item-edit" title="{{localize "hack100.buttons.edit"}}"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="{{localize "hack100.buttons.delete"}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.items.noArmor"}}</p>
          {{/if}}
        </ol>
      </div>

      {{!-- Other Equipment --}}
      <div class="items-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="equipment"></i>
            {{localize "hack100.items.equipment"}}
          </h3>
          <a class="item-control item-create" data-type="item">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list collapsible-content">
          {{#if gear.length}}
            {{#each gear as |item id|}}
            <li class="item flexrow" data-item-id="{{item._id}}">
              <div class="item-name">
                <div class="item-image">
                  <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                </div>
                <h4>{{item.name}}</h4>
              </div>
              <div class="item-controls">
                <a class="item-control item-edit" title="{{localize "hack100.buttons.edit"}} {{localize "hack100.items.item"}}"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="{{localize "hack100.buttons.delete"}} {{localize "hack100.items.item"}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.items.noEquipment"}}</p>
          {{/if}}
        </ol>
      </div>

    </div>

    {{!-- Journal Tab --}}
    <div class="tab journal" data-group="primary" data-tab="journal">

      {{!-- 1. Quick Notes --}}
      <div class="items-section quick-notes-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="quickNotes"></i>
            {{localize "hack100.journal.quickNotes"}}
          </h3>
        </div>
        <div class="collapsible-content">
          <textarea
            name="system.journal.quickNotes"
            class="journal-quick-textarea"
            placeholder="{{localize "hack100.journal.quickNotesPlaceholder"}}">{{system.journal.quickNotes}}</textarea>
        </div>
      </div>

      {{!-- 2. Important Clues & Leads --}}
      <div class="items-section clues-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="clues"></i>
            {{localize "hack100.journal.clues"}}
          </h3>
          <a class="item-control item-create journal-add" data-journal-type="clue" title="{{localize "hack100.journal.addClue"}}">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list collapsible-content">
          {{#if system.journal.clues.length}}
            {{#each system.journal.clues as |clue index|}}
            <div class="journal-entry clue-entry" data-index="{{index}}" data-status="{{clue.status}}">
              <div class="entry-header">
                <i class="fas fa-chevron-right entry-toggle" data-status="{{clue.status}}"></i>
                <input
                  type="text"
                  name="system.journal.clues.{{index}}.title"
                  class="entry-title"
                  value="{{clue.title}}"
                  placeholder="{{localize "hack100.journal.clueTitle"}}"
                  data-journal-type="clue"
                  data-index="{{index}}" />
                <select
                  name="system.journal.clues.{{index}}.status"
                  class="entry-status"
                  data-journal-type="clue"
                  data-index="{{index}}">
                  <option value="unsolved" {{#if (eq clue.status "unsolved")}}selected{{/if}}>{{localize "hack100.journal.unsolved"}}</option>
                  <option value="investigating" {{#if (eq clue.status "investigating")}}selected{{/if}}>{{localize "hack100.journal.investigating"}}</option>
                  <option value="resolved" {{#if (eq clue.status "resolved")}}selected{{/if}}>{{localize "hack100.journal.resolved"}}</option>
                </select>
                <button type="button" class="journal-delete" data-journal-type="clue" data-index="{{index}}" title="{{localize "hack100.buttons.delete"}}">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
              <div class="entry-body">
                <textarea
                  name="system.journal.clues.{{index}}.description"
                  class="entry-description"
                  placeholder="{{localize "hack100.journal.clueDescription"}}"
                  data-journal-type="clue"
                  data-index="{{index}}">{{clue.description}}</textarea>
              </div>
            </div>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.journal.noClues"}}</p>
          {{/if}}
        </ol>
      </div>

      {{!-- 3. NPCs & Factions --}}
      <div class="items-section npcs-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="npcs"></i>
            {{localize "hack100.journal.npcs"}}
          </h3>
          <a class="item-control item-create journal-add" data-journal-type="npc" title="{{localize "hack100.journal.addNpc"}}">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list collapsible-content">
          {{#if system.journal.npcs.length}}
            {{#each system.journal.npcs as |npc index|}}
            <div class="journal-entry npc-entry" data-index="{{index}}" data-relationship="{{npc.relationship}}">
              <div class="entry-header">
                <i class="fas fa-chevron-right entry-toggle" data-relationship="{{npc.relationship}}"></i>
                <input
                  type="text"
                  name="system.journal.npcs.{{index}}.name"
                  class="entry-title"
                  value="{{npc.name}}"
                  placeholder="{{localize "hack100.journal.npcName"}}"
                  data-journal-type="npc"
                  data-index="{{index}}" />
                <select
                  name="system.journal.npcs.{{index}}.relationship"
                  class="entry-relationship"
                  data-journal-type="npc"
                  data-index="{{index}}">
                  <option value="unknown" {{#if (eq npc.relationship "unknown")}}selected{{/if}}>{{localize "hack100.journal.unknown"}}</option>
                  <option value="ally" {{#if (eq npc.relationship "ally")}}selected{{/if}}>{{localize "hack100.journal.ally"}}</option>
                  <option value="neutral" {{#if (eq npc.relationship "neutral")}}selected{{/if}}>{{localize "hack100.journal.neutral"}}</option>
                  <option value="enemy" {{#if (eq npc.relationship "enemy")}}selected{{/if}}>{{localize "hack100.journal.enemy"}}</option>
                </select>
                <button type="button" class="journal-delete" data-journal-type="npc" data-index="{{index}}" title="{{localize "hack100.buttons.delete"}}">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
              <div class="entry-body">
                <textarea
                  name="system.journal.npcs.{{index}}.notes"
                  class="entry-description"
                  placeholder="{{localize "hack100.journal.npcNotes"}}"
                  data-journal-type="npc"
                  data-index="{{index}}">{{npc.notes}}</textarea>
              </div>
            </div>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.journal.noNpcs"}}</p>
          {{/if}}
        </ol>
      </div>

      {{!-- 4. Rumors / Lore Bits --}}
      <div class="items-section rumors-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="rumors"></i>
            {{localize "hack100.journal.rumors"}}
          </h3>
          <a class="item-control item-create journal-add" data-journal-type="rumor" title="{{localize "hack100.journal.addRumor"}}">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list collapsible-content">
          {{#if system.journal.rumors.length}}
            {{#each system.journal.rumors as |rumor index|}}
            <div class="journal-entry rumor-entry" data-index="{{index}}" data-credibility="{{rumor.credibility}}">
              <div class="entry-header">
                <i class="fas fa-chevron-right entry-toggle" data-credibility="{{rumor.credibility}}"></i>
                <input
                  type="text"
                  name="system.journal.rumors.{{index}}.text"
                  class="entry-text"
                  value="{{rumor.text}}"
                  placeholder="{{localize "hack100.journal.rumorText"}}"
                  data-journal-type="rumor"
                  data-index="{{index}}" />
                <input
                  type="text"
                  name="system.journal.rumors.{{index}}.source"
                  class="entry-source"
                  value="{{rumor.source}}"
                  placeholder="{{localize "hack100.journal.rumorSource"}}"
                  data-journal-type="rumor"
                  data-index="{{index}}" />
                <select
                  name="system.journal.rumors.{{index}}.credibility"
                  class="entry-credibility"
                  data-journal-type="rumor"
                  data-index="{{index}}">
                  <option value="unknown" {{#if (eq rumor.credibility "unknown")}}selected{{/if}}>{{localize "hack100.journal.unknown"}}</option>
                  <option value="doubtful" {{#if (eq rumor.credibility "doubtful")}}selected{{/if}}>{{localize "hack100.journal.doubtful"}}</option>
                  <option value="confirmed" {{#if (eq rumor.credibility "confirmed")}}selected{{/if}}>{{localize "hack100.journal.confirmed"}}</option>
                </select>
                <button type="button" class="journal-delete" data-journal-type="rumor" data-index="{{index}}" title="{{localize "hack100.buttons.delete"}}">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.journal.noRumors"}}</p>
          {{/if}}
        </ol>
      </div>

      {{!-- 5. Free Journal Entries --}}
      <div class="items-section free-entries-section">
        <div class="items-header">
          <h3>
            <i class="fas fa-chevron-down section-toggle" data-section="freeEntries"></i>
            {{localize "hack100.journal.freeEntries"}}
          </h3>
          <a class="item-control item-create journal-add" data-journal-type="freeEntry" title="{{localize "hack100.journal.addEntry"}}">
            <i class="fas fa-plus"></i> {{localize "hack100.buttons.add"}}
          </a>
        </div>
        <ol class="items-list collapsible-content">
          {{#if system.journal.freeEntries.length}}
            {{#each system.journal.freeEntries as |entry index|}}
            <div class="journal-entry free-entry" data-index="{{index}}">
              <div class="entry-header">
                <i class="fas fa-chevron-right entry-toggle"></i>
                <input
                  type="text"
                  name="system.journal.freeEntries.{{index}}.title"
                  class="entry-title"
                  value="{{entry.title}}"
                  placeholder="{{localize "hack100.journal.entryTitle"}}"
                  data-journal-type="freeEntry"
                  data-index="{{index}}" />
                <input
                  type="text"
                  name="system.journal.freeEntries.{{index}}.date"
                  class="entry-date"
                  value="{{entry.date}}"
                  placeholder="{{localize "hack100.journal.entryDate"}}"
                  data-journal-type="freeEntry"
                  data-index="{{index}}" />
                <button type="button" class="journal-delete" data-journal-type="freeEntry" data-index="{{index}}" title="{{localize "hack100.buttons.delete"}}">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
              <div class="entry-body">
                <textarea
                  name="system.journal.freeEntries.{{index}}.body"
                  class="entry-description"
                  placeholder="{{localize "hack100.journal.entryBody"}}"
                  data-journal-type="freeEntry"
                  data-index="{{index}}">{{entry.body}}</textarea>
              </div>
            </div>
            {{/each}}
          {{else}}
            <p class="empty-message">{{localize "hack100.journal.noEntries"}}</p>
          {{/if}}
        </ol>
      </div>

    </div>

    {{!-- Settings Tab --}}
    <div class="tab settings" data-group="primary" data-tab="settings">

      {{!-- Color Scheme Section --}}
      <div class="settings-section">
        <h3>{{localize "hack100.settings.appearance"}}</h3>
        <div class="form-group">
          <label for="system.colorScheme">{{localize "hack100.settings.colorScheme"}}</label>
          <select name="system.colorScheme" data-dtype="String">
            <option value="default" {{#if (eq system.colorScheme "default")}}selected{{/if}}>{{localize "hack100.settings.colorSchemes.default"}}</option>
            <option value="dark" {{#if (eq system.colorScheme "dark")}}selected{{/if}}>{{localize "hack100.settings.colorSchemes.dark"}}</option>
            <option value="light" {{#if (eq system.colorScheme "light")}}selected{{/if}}>{{localize "hack100.settings.colorSchemes.light"}}</option>
          </select>
          <p class="hint">{{localize "hack100.settings.colorSchemeHint"}}</p>
        </div>
      </div>

    </div>

  </section>
</form>