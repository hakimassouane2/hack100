<form class="{{cssClass}} {{actor.type}}" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize "hack100.npc.namePlaceholder"}}"/>
      </h1>
    </div>
  </header>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Row 1: Base Rate and Special Rate (2 columns) --}}
    <div class="resources-row">
      {{!-- Base Rate Section --}}
      <div class="rate-section">
        <h3>{{localize "hack100.npc.rate"}}</h3>
        <div class="rate-tracker">
          <div class="rate-value">
            <input type="number" name="system.rate" value="{{system.rate}}" min="0" max="100"/>
            <span>%</span>
          </div>
          <button type="button" class="rate-roll" data-rate="base" title="{{localize "hack100.global.roll"}}">
            <i class="fas fa-dice-d20"></i> {{localize "hack100.global.roll"}}
          </button>
          <button type="button" class="rate-roll attack" data-rate="base" data-attack="true" title="{{localize "hack100.npc.attackHint"}}">
            <i class="fas fa-khanda"></i> {{localize "hack100.npc.attack"}}
          </button>
        </div>
      </div>

      {{!-- Special Rate Section --}}
      <div class="rate-section special-rate">
        <h3>{{localize "hack100.npc.specialRate"}}</h3>
        <input type="text" class="special-rate-label" name="system.specialRateLabel" value="{{system.specialRateLabel}}" placeholder="{{localize "hack100.npc.specialRatePlaceholder"}}"/>
        <div class="rate-tracker">
          <div class="rate-value">
            <input type="number" name="system.specialRate" value="{{system.specialRate}}" min="0" max="100"/>
            <span>%</span>
          </div>
          <button type="button" class="rate-roll" data-rate="special" title="{{localize "hack100.global.roll"}}">
            <i class="fas fa-dice-d20"></i> {{localize "hack100.global.roll"}}
          </button>
          <button type="button" class="rate-roll attack" data-rate="special" data-attack="true" title="{{localize "hack100.npc.attackHint"}}">
            <i class="fas fa-khanda"></i> {{localize "hack100.npc.attack"}}
          </button>
        </div>
      </div>
    </div>

    {{!-- Row 2: Health, Movement, Damage Reduction, Damage Bonus --}}
    <div class="secondary-row">
      {{!-- Health Section --}}
      <div class="health-section">
        <h3>{{localize "hack100.character.health"}}</h3>
        <div class="health-tracker">
          <div class="health-current">
            <label>{{localize "hack100.global.current"}}</label>
            <input type="number" name="system.health.value" value="{{system.health.value}}" min="0" max="{{system.health.max}}" data-health-percent="{{system.healthPercent}}"/>
          </div>
          <div class="health-max">
            <label>{{localize "hack100.global.maximum"}}</label>
            <input type="number" name="system.health.max" value="{{system.health.max}}" min="1"/>
          </div>
        </div>
      </div>

      {{!-- Movement Section --}}
      <div class="movement-section">
        <h3>{{localize "hack100.character.movement"}}</h3>
        <div class="movement-input">
          <input type="number" name="system.movement" value="{{system.movement}}" min="0"/>
          <span>{{localize "hack100.character.squares"}}</span>
        </div>
      </div>

      {{!-- Damage Reduction Section --}}
      <div class="damage-reduction-section">
        <h3>{{localize "hack100.npc.damageReduction"}}</h3>
        <div class="damage-reduction-input">
          <input type="number" name="system.damageReduction" value="{{system.damageReduction}}" min="0"/>
        </div>
      </div>

      {{!-- Damage Bonus Section --}}
      <div class="damage-bonus-section">
        <h3>{{localize "hack100.npc.damageBonus"}}</h3>
        <div class="damage-bonus-input">
          <input type="number" name="system.damageBonus" value="{{system.damageBonus}}" title="{{localize "hack100.npc.damageBonusHint"}}"/>
        </div>
      </div>
    </div>

    {{!-- Combat Techniques Section --}}
    <div class="combat-techniques-section">
      <h3>{{localize "hack100.npc.combatTechniques"}}</h3>
      <textarea name="system.combatTechniques" placeholder="{{localize "hack100.npc.combatTechniquesPlaceholder"}}">{{system.combatTechniques}}</textarea>
    </div>

  </section>
</form>
