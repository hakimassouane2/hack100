<form class="{{cssClass}}" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img
      class="item-img"
      src="{{item.img}}"
      data-edit="img"
      title="{{item.name}}"
    />
    <div class="header-fields">
      <h1 class="charname">
        <input
          name="name"
          type="text"
          value="{{item.name}}"
          placeholder="{{localize "hack100.placeholders.weaponName"}}"
        />
      </h1>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize "hack100.items.description"}}</a>
    <a class="item" data-tab="attributes">{{localize "hack100.items.attributes"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      <div class="item-description-section">
        <div class="form-group">
          <label>{{localize "hack100.items.description"}}</label>
          <textarea
            name="system.description"
            rows="10"
            placeholder="{{localize "hack100.placeholders.descriptionWeapon"}}"
          >{{system.description}}</textarea>
        </div>
      </div>
    </div>

    {{!-- Attributes Tab --}}
    <div class="tab" data-group="primary" data-tab="attributes">

      {{!-- Weapon Type --}}
      <div class="form-group">
        <label>{{localize "hack100.items.weaponType"}}</label>
        <select name="system.weaponType" data-dtype="String">
          <option value="melee" {{#if (eq system.weaponType "melee")}}selected{{/if}}>{{localize "hack100.items.melee"}}</option>
          <option value="ranged" {{#if (eq system.weaponType "ranged")}}selected{{/if}}>{{localize "hack100.items.ranged"}}</option>
        </select>
      </div>

      {{!-- Combat Stats Row --}}
      <div class="item-stats-row">
        <div class="form-group stat-box damage-box">
          <label>{{localize "hack100.items.damageModifier"}}</label>
          <input
            type="text"
            name="system.damage"
            value="{{system.damage}}"
            placeholder="{{localize "hack100.placeholders.damageModifier"}}"
          />
          <p class="hint">{{localize "hack100.hints.weaponDamage"}}</p>
        </div>

        <div class="form-group stat-box attack-box">
          <label>{{localize "hack100.items.attackBonus"}}</label>
          <input
            type="number"
            name="system.attackBonus"
            value="{{system.attackBonus}}"
            data-dtype="Number"
            placeholder="{{localize "hack100.placeholders.attackBonus"}}"
          />
          <p class="hint">{{localize "hack100.hints.weaponAttackBonus"}}</p>
        </div>
      </div>

      {{!-- Range (for ranged weapons) --}}
      <div class="form-group">
        <label>{{localize "hack100.items.rangeForRanged"}}</label>
        <input
          type="text"
          name="system.range"
          value="{{system.range}}"
          placeholder="{{localize "hack100.placeholders.range"}}"
        />
        <p class="hint">{{localize "hack100.hints.weaponRange"}}</p>
      </div>

      {{!-- Location --}}
      <div class="form-group">
        <label>{{localize "hack100.items.location"}}</label>
        <input
          type="text"
          name="system.location"
          value="{{system.location}}"
          placeholder="{{localize "hack100.placeholders.weaponLocation"}}"
        />
        <p class="hint">{{localize "hack100.hints.weaponLocation"}}</p>
      </div>

      {{!-- Additional Details Row --}}
      <div class="item-details-row">
        <div class="form-group">
          <label>{{localize "hack100.items.quantity"}}</label>
          <input
            type="number"
            name="system.quantity"
            value="{{system.quantity}}"
            min="0"
            data-dtype="Number"
            placeholder="{{localize "hack100.placeholders.quantity"}}"
          />
        </div>

        <div class="form-group">
          <label>{{localize "hack100.items.weight"}}</label>
          <input
            type="number"
            name="system.weight"
            value="{{system.weight}}"
            step="0.1"
            data-dtype="Number"
            placeholder="{{localize "hack100.placeholders.weight"}}"
          />
        </div>

        <div class="form-group">
          <label>{{localize "hack100.items.price"}}</label>
          <input
            type="number"
            name="system.price"
            value="{{system.price}}"
            data-dtype="Number"
            placeholder="{{localize "hack100.placeholders.price"}}"
          />
        </div>
      </div>

      {{!-- Equipped Checkbox --}}
      <div class="form-group checkbox-group">
        <label class="checkbox-label">
          <input
            type="checkbox"
            name="system.equipped"
            {{checked system.equipped}}
          />
          <span class="checkbox-text">{{localize "hack100.items.currentlyEquipped"}}</span>
        </label>
        <p class="hint">{{localize "hack100.hints.weaponEquipped"}}</p>
      </div>

    </div>
  </section>
</form>