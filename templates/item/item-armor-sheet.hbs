<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img
      class="item-img"
      src="{{item.img}}"
      data-edit="img"
      title="{{item.name}}"
    />
    <div class="header-fields">
      <h1 class="charname">
        <input
          name="name"
          type="text"
          value="{{item.name}}"
          placeholder="Item name"
        />
      </h1>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="attributes">Attributes</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="description">
      <div class="form-group">
        <label>Description:</label>
        <textarea
          name="system.description"
          rows="8"
        >{{system.description}}</textarea>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="attributes">
      <div class="form-group">
        <label>Quantity:</label>
        <input
          type="number"
          name="system.quantity"
          value="{{system.quantity}}"
          min="0"
          data-dtype="Number"
        />
      </div>

      <div class="form-group">
        <label>Location:</label>
        <input
          type="text"
          name="system.location"
          value="{{system.location}}"
          placeholder="Where is it carried?"
        />
        <p class="hint">E.g., "backpack", "belt pouch", "left hand", "pocket"</p>
      </div>

      <div class="form-group">
        <label>Weight:</label>
        <input
          type="number"
          name="system.weight"
          value="{{system.weight}}"
          step="0.1"
          data-dtype="Number"
        />
      </div>

      <div class="form-group">
        <label>Price:</label>
        <input
          type="number"
          name="system.price"
          value="{{system.price}}"
          data-dtype="Number"
        />
      </div>

      <div class="form-group">
        <label>
          <input
            type="checkbox"
            name="system.equipped"
            {{checked system.equipped}}
          />
          Equipped/In Use
        </label>
      </div>
    </div>
  </section>
</form>