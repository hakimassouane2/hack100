<form class="{{cssClass}}" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img
      class="item-img"
      src="{{item.img}}"
      data-edit="img"
      title="{{item.name}}"
    />
    <div class="header-fields">
      <h1 class="charname">
        <input
          name="name"
          type="text"
          value="{{item.name}}"
          placeholder="{{localize "hack100.placeholders.armorName"}}"
        />
      </h1>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize "hack100.items.description"}}</a>
    <a class="item" data-tab="attributes">{{localize "hack100.items.attributes"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      <div class="item-description-section">
        <div class="form-group">
          <label>{{localize "hack100.items.description"}}</label>
          <textarea
            name="system.description"
            rows="10"
            placeholder="{{localize "hack100.placeholders.descriptionArmor"}}"
          >{{system.description}}</textarea>
        </div>
      </div>
    </div>

    {{!-- Attributes Tab --}}
    <div class="tab" data-group="primary" data-tab="attributes">

      {{!-- Protection and Penalties Row --}}
      <div class="item-stats-row">
        <div class="form-group stat-box protection-box">
          <label>{{localize "hack100.items.protectionValue"}}</label>
          <select name="system.protection" data-dtype="String">
            <option value="0" {{#if (eq system.protection "0")}}selected{{/if}}>0</option>
            <option value="1" {{#if (eq system.protection "1")}}selected{{/if}}>1</option>
            <option value="2" {{#if (eq system.protection "2")}}selected{{/if}}>2</option>
            <option value="3" {{#if (eq system.protection "3")}}selected{{/if}}>3</option>
            <option value="4" {{#if (eq system.protection "4")}}selected{{/if}}>4</option>
            <option value="5" {{#if (eq system.protection "5")}}selected{{/if}}>5</option>
            <option value="6" {{#if (eq system.protection "6")}}selected{{/if}}>6</option>
          </select>
          <p class="hint">{{localize "hack100.hints.armorProtection"}}</p>
        </div>

        <div class="form-group stat-box penalty-box">
          <label>{{localize "hack100.items.movementPenalty"}}</label>
          <select name="system.movementPenalty" data-dtype="Number">
            {{#select system.movementPenalty}}
            <option value="0">0</option>
            <option value="1">-1</option>
            <option value="2">-2</option>
            <option value="3">-3</option>
            <option value="4">-4</option>
            <option value="5">-5</option>
            <option value="6">-6</option>
            {{/select}}
          </select>
          <p class="hint">{{localize "hack100.hints.armorMovementPenalty"}}</p>
        </div>

        <div class="form-group stat-box penalty-box">
          <label>{{localize "hack100.items.agilityPenalty"}}</label>
          <select name="system.agilityPenalty" data-dtype="Number">
            {{#select system.agilityPenalty}}
            <option value="0">0%</option>
            <option value="10">-10%</option>
            <option value="20">-20%</option>
            <option value="30">-30%</option>
            {{/select}}
          </select>
          <p class="hint">{{localize "hack100.hints.armorAgilityPenalty"}}</p>
        </div>
      </div>

      {{!-- Location and Quantity --}}
      <div class="form-group">
        <label>{{localize "hack100.items.location"}}</label>
        <input
          type="text"
          name="system.location"
          value="{{system.location}}"
          placeholder="{{localize "hack100.placeholders.armorLocation"}}"
        />
        <p class="hint">{{localize "hack100.hints.armorLocation"}}</p>
      </div>

      <div class="item-details-row">
        <div class="form-group">
          <label>{{localize "hack100.items.quantity"}}</label>
          <input
            type="number"
            name="system.quantity"
            value="{{system.quantity}}"
            min="0"
            data-dtype="Number"
          />
        </div>

        <div class="form-group">
          <label>{{localize "hack100.items.weightPerItem"}}</label>
          <input
            type="number"
            name="system.weight"
            value="{{system.weight}}"
            step="0.1"
            data-dtype="Number"
            placeholder="{{localize "hack100.placeholders.weight"}}"
          />
        </div>

        <div class="form-group">
          <label>{{localize "hack100.items.price"}}</label>
          <input
            type="number"
            name="system.price"
            value="{{system.price}}"
            data-dtype="Number"
            placeholder="{{localize "hack100.placeholders.price"}}"
          />
        </div>
      </div>

      {{!-- Equipped Checkbox --}}
      <div class="form-group checkbox-group">
        <label class="checkbox-label">
          <input
            type="checkbox"
            name="system.equipped"
            {{checked system.equipped}}
          />
          <span class="checkbox-text">{{localize "hack100.items.currentlyEquipped"}}</span>
        </label>
        <p class="hint">{{localize "hack100.hints.armorEquipped"}}</p>
      </div>

    </div>
  </section>
</form>